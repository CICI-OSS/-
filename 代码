import gradio as gr
from ultralytics import YOLO
from paddleocr import PaddleOCR
import cv2
import numpy as np
from PIL import Image, ImageDraw, ImageFont
from pathlib import Path


# =========================================================
# 1. 项目路径
# =========================================================

BASE_DIR = Path(__file__).resolve().parent

MODEL_PATH = BASE_DIR / "models" / "v8best.pt"
FONT_PATH = BASE_DIR / "fonts" / "chinese.ttf"


# =========================================================
# 2. 加载 YOLO 模型
# =========================================================

print("正在加载 YOLOv8 模型...")

if MODEL_PATH.exists():
    print(f"使用模型: {MODEL_PATH}")
    yolo_model = YOLO(str(MODEL_PATH))
else:
    print(f"警告：找不到自定义模型: {MODEL_PATH}")
    print("将使用官方 yolov8n.pt 进行测试。")

    yolo_model = YOLO("yolov8n.pt")


# =========================================================
# 3. 加载 PaddleOCR
# =========================================================

print("正在加载 PaddleOCR 模型...")

ocr = PaddleOCR(
    use_angle_cls=True,
    lang="ch",
    show_log=False,
    drop_score=0.5
)

print("模型加载完成！")


# =========================================================
# 4. OCR 图像预处理
# =========================================================

def preprocess_for_ocr(img_crop):
    """
    对 YOLO 裁剪区域进行 OCR 预处理。
    """

    if img_crop is None or img_crop.size == 0:
        return img_crop

    h, w = img_crop.shape[:2]

    # -----------------------------------------------------
    # 1. 小图片放大
    # -----------------------------------------------------

    if h < 48:
        scale = 48.0 / h

        img_crop = cv2.resize(
            img_crop,
            None,
            fx=scale,
            fy=scale,
            interpolation=cv2.INTER_CUBIC
        )

    # -----------------------------------------------------
    # 2. 灰度
    # -----------------------------------------------------

    gray = cv2.cvtColor(
        img_crop,
        cv2.COLOR_BGR2GRAY
    )

    # -----------------------------------------------------
    # 3. CLAHE 对比度增强
    # -----------------------------------------------------

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    enhanced = clahe.apply(gray)

    # -----------------------------------------------------
    # 4. 锐化
    # -----------------------------------------------------

    kernel = np.array([
        [0, -1, 0],
        [-1, 5, -1],
        [0, -1, 0]
    ])

    sharpened = cv2.filter2D(
        enhanced,
        -1,
        kernel
    )

    # -----------------------------------------------------
    # 5. 转回 3 通道
    # -----------------------------------------------------

    img_final = cv2.cvtColor(
        sharpened,
        cv2.COLOR_GRAY2BGR
    )

    # -----------------------------------------------------
    # 6. 添加白边
    # -----------------------------------------------------

    border_size = 10

    img_final = cv2.copyMakeBorder(
        img_final,
        top=border_size,
        bottom=border_size,
        left=border_size,
        right=border_size,
        borderType=cv2.BORDER_CONSTANT,
        value=(255, 255, 255)
    )

    return img_final


# =========================================================
# 5. 绘制检测框和 OCR 文字
# =========================================================

def box_label(
    image,
    box,
    label="",
    color=(128, 128, 128),
    txt_color=(255, 255, 255)
):

    lw = max(
        round(sum(image.size) / 2 * 0.003),
        2
    )

    p1 = (
        int(box[0]),
        int(box[1])
    )

    p2 = (
        int(box[2]),
        int(box[3])
    )

    draw = ImageDraw.Draw(image)

    # 检测框
    draw.rectangle(
        [p1, p2],
        outline=color,
        width=lw
    )

    if not label:
        return

    # -----------------------------------------------------
    # 加载中文字体
    # -----------------------------------------------------

    font_size = 36

    if FONT_PATH.exists():
        try:
            font = ImageFont.truetype(
                str(FONT_PATH),
                font_size
            )
        except Exception as e:
            print(f"字体加载失败: {e}")
            font = ImageFont.load_default()
    else:
        print(f"警告：找不到中文字体: {FONT_PATH}")
        font = ImageFont.load_default()

    # -----------------------------------------------------
    # 计算文字尺寸
    # -----------------------------------------------------

    bbox = draw.textbbox(
        (0, 0),
        label,
        font=font
    )

    text_w = bbox[2] - bbox[0]
    text_h = bbox[3] - bbox[1]

    outside = p1[1] - text_h - 3 >= 0

    if outside:
        label_box = [
            p1[0],
            p1[1] - text_h - 3,
            p1[0] + text_w,
            p1[1]
        ]

        text_position = (
            p1[0],
            p1[1] - text_h - 3
        )

    else:
        label_box = [
            p1[0],
            p1[1],
            p1[0] + text_w,
            p1[1] + text_h + 3
        ]

        text_position = (
            p1[0],
            p1[1]
        )

    # 文字背景
    draw.rectangle(
        label_box,
        fill=color
    )

    # 文字
    draw.text(
        text_position,
        label,
        fill=txt_color,
        font=font
    )


# =========================================================
# 6. 图片处理
# =========================================================

def process_images(image_files):

    if not image_files:
        return []

    processed_results = []

    for img_path in image_files:

        print(f"正在处理: {img_path}")

        # -------------------------------------------------
        # 读取图片
        # -------------------------------------------------

        img_cv2 = cv2.imread(img_path)

        if img_cv2 is None:
            print(f"无法读取图片: {img_path}")
            continue

        img_process = img_cv2.copy()

        # PIL 用于最终绘图
        img_pil = Image.fromarray(
            cv2.cvtColor(
                img_cv2,
                cv2.COLOR_BGR2RGB
            )
        )

        # -------------------------------------------------
        # YOLO 检测
        # -------------------------------------------------

        yolo_results = yolo_model(
            img_cv2,
            conf=0.25
        )

        h_img, w_img = img_cv2.shape[:2]

        # -------------------------------------------------
        # 遍历检测结果
        # -------------------------------------------------

        for result in yolo_results:

            boxes = result.boxes.xyxy.cpu().numpy()

            for box in boxes:

                x1, y1, x2, y2 = map(
                    int,
                    box
                )

                # -------------------------------------------------
                # 外扩裁剪
                # -------------------------------------------------

                expand_w = int(
                    (x2 - x1) * 0.05
                )

                expand_h = int(
                    (y2 - y1) * 0.05
                )

                x1_ext = max(
                    0,
                    x1 - expand_w
                )

                y1_ext = max(
                    0,
                    y1 - expand_h
                )

                x2_ext = min(
                    w_img,
                    x2 + expand_w
                )

                y2_ext = min(
                    h_img,
                    y2 + expand_h
                )

                if (
                    x2_ext <= x1_ext
                    or y2_ext <= y1_ext
                ):
                    continue

                # -------------------------------------------------
                # 裁剪
                # -------------------------------------------------

                crop_img = img_process[
                    y1_ext:y2_ext,
                    x1_ext:x2_ext
                ]

                # -------------------------------------------------
                # OCR 预处理
                # -------------------------------------------------

                crop_img_enhanced = preprocess_for_ocr(
                    crop_img
                )

                # -------------------------------------------------
                # PaddleOCR
                # -------------------------------------------------

                ocr_result = ocr.ocr(
                    crop_img_enhanced,
                    cls=True,
                    det=True,
                    rec=True
                )

                # -------------------------------------------------
                # 提取文字
                # -------------------------------------------------

                texts = []

                if ocr_result and ocr_result[0]:

                    for line in ocr_result[0]:

                        text_content = line[1][0]
                        text_score = line[1][1]

                        if text_score > 0.6:
                            texts.append(
                                text_content
                            )

                ocr_text = " ".join(texts)

                # -------------------------------------------------
                # 随机颜色
                # -------------------------------------------------

                color = tuple(
                    np.random.randint(
                        0,
                        180,
                        3
                    ).tolist()
                )

                # -------------------------------------------------
                # 绘制 YOLO 原始框
                # -------------------------------------------------

                box_label(
                    img_pil,
                    [x1, y1, x2, y2],
                    label=ocr_text,
                    color=color
                )

        processed_results.append(img_pil)

    return processed_results


# =========================================================
# 7. Gradio 界面
# =========================================================

with gr.Blocks(
    title="YOLOv8 + PaddleOCR"
) as demo:

    gr.Markdown(
        "# YOLOv8 + PaddleOCR 电动车牌识别"
    )

    gr.Markdown(
        """
        支持：

        - YOLOv8 目标检测
        - PaddleOCR 中文文字识别
        - 外扩裁剪
        - 小图片自动放大
        - CLAHE 对比度增强
        - 图像锐化
        - OCR 自动纠偏
        """
    )

    with gr.Row():

        with gr.Column():

            input_imgs = gr.File(
                label="上传图片",
                file_count="multiple",
                type="filepath",
                file_types=["image"]
            )

            process_btn = gr.Button(
                "开始识别",
                variant="primary"
            )

        with gr.Column():

            output_gallery = gr.Gallery(
                label="识别结果",
                show_label=True,
                columns=2,
                height="auto"
            )

    process_btn.click(
        fn=process_images,
        inputs=input_imgs,
        outputs=output_gallery
    )


