with gr.Blocks(title="YOLOv8 + PaddleOCR") as demo:
    gr.Markdown("## YOLOv8 + PaddleOCR 电动车牌识别")
    gr.Markdown("包含:外扩裁剪、超分辨率放大、CLAHE对比度增强、自动纠偏")

    with gr.Row():
        with gr.Column():
            input_imgs = gr.File(
                label="上传图片",
                file_count="multiple",
                type="filepath",
                file_types=["image"]
            )
            process_btn = gr.Button("开始识别", variant="primary")

        with gr.Column():
            output_gallery = gr.Gallery(
                label="识别结果",
                show_label=True,
                columns=2,
                height="auto"
            )
    

    process_btn.click(
        fn=process_images,
        inputs=input_imgs,
        outputs=output_gallery
    )

if __name__ == "__main__":
    demo.launch()

