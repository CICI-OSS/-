import gradio as gr
from ultralytics import YOLO
from paddleocr import PaddleOCR
import cv2
import numpy as np
from PIL import Image, ImageDraw, ImageFont
import math

# ---------------------------------------------------------
# 1. 初始化模型
# ---------------------------------------------------------
print("正在加载 YOLOv8 模型...")
model_path = '/content/best.pt'
try:
    yolo_model = YOLO(model_path)
except:
    print(f"找不到 {model_path}，加载官方 yolov8n.pt 测试...")
    yolo_model = YOLO('yolov8n.pt')
    
print("正在加载 PaddleOCR 模型...")
# drop_score=0.5: 丢弃置信度低的文本
# use_angle_cls=True: 开启方向分类（关键，用于矫正颠倒/旋转的文字）
ocr = PaddleOCR(
    lang="ch",
    text_rec_score_thresh=0.5,
    use_textline_orientation=True
)

# ---------------------------------------------------------
# 2. 图像预处理函数 (核心改进)
# ---------------------------------------------------------
def preprocess_for_ocr(img_crop):
    """
    对裁剪下来的图片进行预处理，提高 OCR 识别率
    """
    if img_crop.size == 0:
        return img_crop

    h, w = img_crop.shape[:2]

    # 1.【放大】如果图片太小（高度小于48像素），进行放大
    # OCR 模型通常对高度 32-64 像素的文字识别效果最好，太小了认不出
    if h < 48:
        scale = 48.0 / h
        # 使用三次插值放大，效果比线性插值好
        img_crop = cv2.resize(img_crop, None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC)

    # 2.【灰度 + 对比度增强】
    # 转灰度
    gray = cv2.cvtColor(img_crop, cv2.COLOR_BGR2GRAY)

    # 使用 CLAHE (限制对比度自适应直方图均衡化)
    # 这比全局直方图均衡化更好，不会过度放大噪声，能有效处理光照不均匀
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    enhanced = clahe.apply(gray)

    # 3.【锐化】
    # 简单的锐化卷积核
    kernel = np.array([[0, -1, 0],
                       [-1, 5,-1],
                       [0, -1, 0]])
    sharpened = cv2.filter2D(enhanced, -1, kernel)

    # 4.【转回 3通道】PaddleOCR 默认接收 3通道图片
    img_final = cv2.cvtColor(sharpened, cv2.COLOR_GRAY2BGR)

    # 5.【加白边】(Padding)
    # 这一点非常重要！OCR模型在处理边缘文字时容易出错。
    # 加一圈白边给 OCR 模型“呼吸空间”，有助于它内部的检测框回归和矫正
    border_size = 10
    img_final = cv2.copyMakeBorder(
        img_final,
        top=border_size, bottom=border_size, left=border_size, right=border_size,
        borderType=cv2.BORDER_CONSTANT,
        value=(255, 255, 255) # 白色背景
    )

    return img_final

# ---------------------------------------------------------
# 3. 绘图与主逻辑
# ---------------------------------------------------------
def box_label(image, box, label='', color=(128, 128, 128), txt_color=(255, 255, 255)):
    """在 PIL 图片上绘制矩形框和中文文字"""
    lw = max(round(sum(image.size) / 2 * 0.003), 2)
    p1, p2 = (int(box[0]), int(box[1])), (int(box[2]), int(box[3]))

    draw = ImageDraw.Draw(image)
    draw.rectangle([p1, p2], outline=color, width=lw)

    if label:
        try:
            # 【字体大小调整】
            # 这里改大了比例，让字更大。 min(image.size) / 15
            font_size = 36
            font = ImageFont.truetype("/content/drive/MyDrive/Colab_Notebooks/chinese.ttf", font_size)
        except IOError:
            font = ImageFont.load_default()
            print("警告: 未找到 simhei.ttf，无法调整字体大小。")

        w, h = draw.textbbox((0, 0), label, font=font)[2:]
        outside = p1[1] - h - 3 >= 0
        p2_label = p1[0] + w, p1[1] - h - 3 if outside else p1[1] + h + 3

        draw.rectangle([p1[0], p2_label[1], p2_label[0], p1[1]], fill=color, width=lw)
        draw.text((p1[0], p2_label[1]), label, fill=txt_color, font=font)

def process_images(image_files):
    if not image_files:
        return []

    processed_results = []

    for img_path in image_files:
        # 读取 OpenCV 格式 (BGR)
        img_cv2 = cv2.imread(img_path)
        # 复制一份用于裁剪，避免绘图污染
        img_process = img_cv2.copy()

        # 转换 PIL 用于最后的绘图
        img_pil = Image.fromarray(cv2.cvtColor(img_cv2, cv2.COLOR_BGR2RGB))

        # YOLOv8 检测
        yolo_results = yolo_model(img_cv2, conf=0.25)

        h_img, w_img = img_cv2.shape[:2]

        for result in yolo_results:
            boxes = result.boxes.xyxy.cpu().numpy()

            for box in boxes:
                x1, y1, x2, y2 = map(int, box)

                # -------------------------------------------------
                # 改进点 1：外扩裁剪 (Expand Crop)
                # -------------------------------------------------
                # YOLO 框可能很紧，我们向四周外扩 2% ~ 5% 的像素，
                # 保证文字不被切断，同时给 OCR 更多背景信息
                expand_w = int((x2 - x1) * 0.05)
                expand_h = int((y2 - y1) * 0.05)

                x1_ext = max(0, x1 - expand_w)
                y1_ext = max(0, y1 - expand_h)
                x2_ext = min(w_img, x2 + expand_w)
                y2_ext = min(h_img, y2 + expand_h)

                if x2_ext <= x1_ext or y2_ext <= y1_ext:
                    continue

                # 裁剪图片
                crop_img = img_process[y1_ext:y2_ext, x1_ext:x2_ext]

                # -------------------------------------------------
                # 改进点 2：图像增强与预处理
                # -------------------------------------------------
                crop_img_enhanced = preprocess_for_ocr(crop_img)

                # Debug: 如果你想看预处理后的图长什么样，可以取消下面注释保存看看
                # cv2.imwrite(f"debug_{x1}.jpg", crop_img_enhanced)

                # PaddleOCR 识别
                # det=True: 开启检测。即使是裁剪图，开启检测也能更好地处理倾斜文本（Paddle内部会画小框并矫正）
                # rec=True: 开启识别
                ocr_result = ocr.ocr(crop_img_enhanced, cls=True, det=True, rec=True)

                ocr_text = ""
                if ocr_result and ocr_result[0]:
                    # 提取置信度最高的文本
                    # ocr_result结构: [[[[x,y]..], (text, score)], ...]
                    # 我们把所有识别到的文本拼接起来
                    texts = []
                    for line in ocr_result[0]:
                        text_content = line[1][0]
                        text_score = line[1][1]
                        # 过滤掉置信度太低的乱码
                        if text_score > 0.6:
                            texts.append(text_content)

                    ocr_text = " ".join(texts)

                if not ocr_text:
                    ocr_text = "" # 没识别到就不显示，或者显示 "No Text"

                # 绘图 (画在原图的框上)
                color = tuple(np.random.randint(0, 180, 3).tolist())
                # 注意：这里传给绘图的是 YOLO 原始的 box (x1,y1,x2,y2)，不是外扩后的
                box_label(img_pil, [x1, y1, x2, y2], label=ocr_text, color=color)

        processed_results.append(img_pil)

    return processed_results

